ARG BASE_IMAGE

FROM $BASE_IMAGE

ARG TARGETOS
ARG TARGETARCH
ARG SRC_SUFFIX=""

# binary_dir is a docker buildx bake named context, not a stage
# hadolint ignore=DL3022
COPY --from=binary_dir gitlab-runner-helper.${TARGETOS}-${TARGETARCH}${SRC_SUFFIX} /usr/bin/gitlab-runner-helper
CMD ["/usr/bin/gitlab-runner-helper"]
